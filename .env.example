# Copy this file to .env and fill in what you use. .env is ignored by git:
# never commit real credentials, and never put them in configs/*.yaml.

# Blizzard Battle.net developer API (optional): enables live item lookup.
# Create a client at https://develop.battle.net/access/clients
WOWGEAR_BLIZZARD_CLIENT_ID=
WOWGEAR_BLIZZARD_CLIENT_SECRET=

# Warcraft Logs API v2 (optional): planned, not used in version 1.
# Create a client at https://www.warcraftlogs.com/api/clients
WOWGEAR_WCL_CLIENT_ID=
WOWGEAR_WCL_CLIENT_SECRET=

# Optional overrides
# WOWGEAR_HOME=        project root; defaults to the folder that holds configs/app.yaml
# WOWGEAR_DATA_DIR=    where caches and saved characters live; defaults to ./data
# WOWGEAR_LOG_LEVEL=   DEBUG, INFO, WARNING or ERROR
