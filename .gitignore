# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Secrets: never commit real credentials
.env
.env.*
!.env.example
*.pem
*.key
secrets/
.streamlit/secrets.toml

# Local data: generated, cached or saved by the user
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/cache/*
!data/cache/.gitkeep
data/user/*
!data/user/.gitkeep
*.sqlite3
*.db
logs/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
